# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env NÃO vai pro git.

# Chave do Gemini: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Opcional: outro modelo do Gemini (padrão gemini-2.5-flash)
# GEMINI_MODELO=gemini-2.5-flash

# Opcional: chave Pix mandada ao cliente que escolhe Pix (padrão: loja.pixKey do shared/dados.js)
# PIX_CHAVE=
