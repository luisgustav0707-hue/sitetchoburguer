# Opcional. Copie para .env (na mesma pasta) só se quiser mudar algo.
# O .env NÃO vai pro git nem pro pacote de download.

# Chave do Gemini: normalmente vem do painel (Configurações → WhatsApp).
# Preencher aqui faz o bot usar esta em vez da do painel (útil em teste).
# GEMINI_API_KEY=

# Modelos do Gemini em ordem de preferência, separados por vírgula
# (se um estiver fora do ar, usa o próximo). Padrão:
# GEMINI_MODELO=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

# Chave Pix mandada ao cliente que escolhe Pix (padrão: loja.pixKey do shared/dados.js)
# PIX_CHAVE=

# Navegador usado pelo WhatsApp Web (padrão: Chrome ou Edge instalados)
# CHROME_PATH=
