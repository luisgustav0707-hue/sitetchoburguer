rules_version = '2';

// ── Regras de segurança do Firestore — Tcho Burguer ──────────────────────────
// Objetivo: o cliente (SEM login) só faz o necessário pra pedir; tudo que é
// gestão exige um admin autenticado (Firebase Auth) cujo UID esteja em /admins.
//
// Como um admin é reconhecido: existe o documento  /admins/{seu_uid}
// (crie no console: Authentication → pegue o UID → Firestore → coleção "admins"
//  → documento com ID = UID). Sem esse doc, mesmo logado, não é admin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // O app de impressão (pasta impressora-automatica/) loga com um usuário
    // dedicado AO COMPUTADOR, criado pela function pareiarImpressora com o
    // custom claim perfil:'impressora'. Lê-se o claim (e não um documento)
    // porque isso não custa uma leitura extra a cada regra avaliada.
    // O que esse perfil pode: ver a fila de impressão, marcar o que já saiu, e
    // marcar `impresso` no pedido. Nada além disso — não é um admin.
    function isImpressora() {
      return signedIn() && request.auth.token.perfil == 'impressora';
    }

    // Lista de admins: só o próprio admin lê; ninguém escreve pelo app
    // (gerenciado manualmente no console).
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Leitura pública (o cardápio precisa abrir sem login) ─────────────────
    // Escrita só admin, com exceções cirúrgicas pro fluxo do cliente.

    // config: cliente só pode mexer no doc `contador` e só no campo `ultimo`
    // (número sequencial do pedido — mesma fonte do balcão). O resto (horários,
    // marca, bairros, taxas...) é só admin.
    match /config/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
      allow update: if doc == 'contador'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo']);
    }

    // cardapio: cliente só pode baixar estoque (doc `estoque`, campo `data`).
    // Preços/itens/disponibilidade: só admin.
    match /cardapio/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
      allow update: if doc == 'estoque'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data']);
    }

    match /fotos/{doc} { allow read: if true; allow write: if isAdmin(); }

    // ── Cupons ───────────────────────────────────────────────────────────────
    // Cliente lê (pra validar) e só pode incrementar o contador de uso.
    // Criar/editar/apagar cupom: só admin.
    match /cupons/{doc} {
      allow read:   if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usosFeitos']);
    }

    // ── Pedidos ──────────────────────────────────────────────────────────────
    // Cliente CRIA o pedido e lê APENAS o próprio doc (pelo ID aleatório que só
    // ele tem). Não pode listar todos, editar nem apagar — isso é do admin.
    match /pedidos/{id} {
      allow create: if true;
      allow get:    if true;
      allow list, update, delete: if isAdmin();
      // O app de impressão só encosta no campo `impresso` — é o que faz o
      // Kanban do navegador (se estiver aberto) parar de achar que falta
      // imprimir. `hasOnly` impede que um PC pareado mexa em preço ou status.
      allow get, update: if isImpressora()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impresso']);
    }

    // ── Clientes (CRM) ───────────────────────────────────────────────────────
    // O cliente cria/atualiza o próprio cadastro ao pedir (upsertCliente usa uma
    // transação que LÊ o doc pelo telefone → precisa de `get`). Listar a base
    // inteira (`list`) e apagar: só admin.
    // OBS de privacidade: `get` deixa quem souber o telefone consultar aquele
    // cadastro. Endurecimento futuro (Fase 2): mover a agregação pra uma Cloud
    // Function e fechar clientes 100% (só admin). Ver runbook.
    match /clientes/{id} {
      allow get:    if true;
      allow create, update: if true;
      allow list, delete: if isAdmin();
    }

    // ── Só admin (gestão / operação interna) ─────────────────────────────────
    match /mesas/{d}     { allow read, write: if isAdmin(); }
    match /garcons/{d}   { allow read, write: if isAdmin(); }
    match /usuarios/{d}  { allow read, write: if isAdmin(); }
    match /campanhas/{d} { allow read, write: if isAdmin(); }
    match /despesas/{d}  { allow read, write: if isAdmin(); }

    // Tokens de push do admin (aparelhos que recebem notificação de pedido).
    // Só o admin logado cadastra o próprio; a Cloud Function lê via Admin SDK.
    match /push_tokens/{t} { allow read, write: if isAdmin(); }

    // Analytics: o site do cliente escreve (contagem de visita / "online agora"),
    // mas só o admin lê. São contadores, sem dado sensível.
    match /stats/{d}     { allow read: if isAdmin(); allow write: if true; }
    match /presenca/{d}  { allow read: if isAdmin(); allow write: if true; }

    // ── App de impressão automática ──────────────────────────────────────────
    // Fila de trabalhos de impressão: a Cloud Function enfileirarImpressao
    // escreve o HTML pronto do cupom aqui, o app pareado lê e imprime.
    // O conteúdo é o cupom inteiro (nome, telefone e endereço do cliente),
    // por isso nada aqui é público.
    match /impressoes/{id} {
      allow read, write: if isAdmin();
      allow read: if isImpressora();
      // Depois de imprimir, o app fecha o trabalho. Só esses dois campos —
      // reescrever o HTML da fila não é papel dele.
      allow update: if isImpressora()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'impressoEm']);
    }

    // Computadores pareados (o painel lista e revoga). Quem escreve é só a
    // Cloud Function, via Admin SDK — que não passa por estas regras.
    match /impressoras/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Códigos de pareamento: fechados pra todo mundo de propósito. Se fossem
    // legíveis, qualquer visitante do site leria um código válido e parearia o
    // próprio computador na loja. Só as functions tocam nisso.
    match /codigosImpressora/{codigo} {
      allow read, write: if false;
    }

    // Qualquer coleção não listada acima: negado por padrão.
    match /{document=**} { allow read, write: if false; }
  }
}
